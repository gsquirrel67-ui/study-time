:root {
  --bg: #020817;
  --panel: #0f172a;
  --muted: #94a3b8;
  --line: #1e293b;
  --white: #e2e8f0;
  --green: #34d399;
  --violet: #8b5cf6;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  font-family: Inter, Arial, sans-serif;
  background: var(--bg);
  color: var(--white);
}

body {
  min-height: 100vh;
}

button,
input,
textarea {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  background: var(--bg);
  color: var(--white);
}

.top-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 28px;
  background: rgba(2, 8, 23, 0.8);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(10px);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--green);
  color: #042f2e;
  display: grid;
  place-items: center;
  font-weight: 800;
}

.brand-wrap h1 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
}

.brand-wrap p {
  margin: 4px 0 0;
  font-size: 0.7rem;
  color: var(--muted);
}

.search-wrap {
  position: relative;
  width: min(420px, 100%);
}

.search-wrap input {
  width: 100%;
  border: 1px solid var(--line);
  background: #0b1220;
  color: var(--white);
  border-radius: 12px;
  padding: 12px 14px 12px 38px;
  outline: none;
}

.search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted);
}

.content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 28px 24px 50px;
}

.panel {
  margin-bottom: 34px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.section-header h2 {
  margin: 0;
  font-size: 1rem;
  color: #dfe7f2;
}

.section-header span {
  font-size: 0.75rem;
  color: var(--muted);
}

.inline-form,
.game-form {
  display: grid;
  gap: 12px;
  background: rgba(17, 24, 39, 0.75);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px;
  margin-bottom: 20px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.inline-form {
  grid-template-columns: 1.2fr 1.4fr 1fr auto;
}

.inline-form input,
.game-form input,
.game-form textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #020817;
  color: var(--white);
  padding: 12px 14px;
  outline: none;
}

.game-form textarea {
  resize: vertical;
}

.inline-form button,
.game-form button,
.back-btn {
  border: none;
  border-radius: 10px;
  background: var(--violet);
  color: white;
  cursor: pointer;
  padding: 12px 16px;
  font-weight: 600;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
}

.site-card,
.game-card {
  position: relative;
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 16px;
  min-height: 200px;
  transition: 0.2s ease;
}

.site-card:hover,
.game-card:hover {
  border-color: rgba(52, 211, 153, 0.7);
  transform: translateY(-2px);
}

.site-top,
.game-top {
  display: flex;
  align-items: start;
  justify-content: space-between;
  margin-bottom: 12px;
}

.site-badge,
.game-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: rgba(16, 185, 129, 0.12);
  color: var(--green);
  display: grid;
  place-items: center;
  font-size: 1.3rem;
}

.game-icon {
  background: rgba(139, 92, 246, 0.12);
  color: var(--violet);
}

.delete-btn {
  border: none;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
  font-size: 1rem;
}

.site-main {
  display: block;
  width: 100%;
  border: none;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
  padding: 0;
}

.site-main h3 {
  margin: 0;
  font-size: 0.98rem;
}

.site-main p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 0.74rem;
  word-break: break-word;
}

.site-main span {
  display: inline-block;
  margin-top: 10px;
  padding: 5px 8px;
  border-radius: 999px;
  background: rgba(52, 211, 153, 0.12);
  color: var(--green);
  font-size: 0.7rem;
  font-weight: 600;
}

.click-hint,
.play-hint {
  margin-top: 14px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.7rem;
  color: var(--green);
}

.play-hint {
  color: var(--violet);
}

.game-card img {
  width: 100%;
  height: 96px;
  object-fit: cover;
  border-radius: 12px;
  display: block;
  border: 1px solid var(--line);
}

.empty-box {
  border: 1px dashed var(--line);
  background: rgba(15, 23, 42, 0.5);
  border-radius: 18px;
  padding: 32px;
  text-align: center;
  color: var(--muted);
}

.game-screen {
  min-height: 100vh;
  background: #020817;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 20px;
  border-bottom: 1px solid var(--line);
  background: rgba(2, 8, 23, 0.9);
}

.topbar h3 {
  margin: 0;
  font-size: 0.95rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.running-label {
  margin-left: auto;
  font-size: 0.7rem;
  color: var(--muted);
}

.back-btn {
  padding: 9px 12px;
}

.game-frame {
  width: 100%;
  min-height: calc(100vh - 74px);
  border: none;
  display: block;
  background: white;
}

@media (max-width: 760px) {
  .top-header {
    flex-direction: column;
    align-items: stretch;
  }

  .inline-form {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }
}
